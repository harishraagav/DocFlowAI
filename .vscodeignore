# Development and repository files
.vscode/**
.vscode-test/**
.vscode-test.mjs
.git/**
.github/**
.gitignore
.eslint*
.prettier*
tsconfig*.json
webpack.config.js

# Source and test files
src/**
test/**
tests/**
out/**
coverage/**

# Generated activity data and logs
DocFlowAI_Activity_Log.md
*.log

# Operating system files
.DS_Store
Thumbs.db

# Playwright: exclude TypeScript declarations and unused CLI entry points
node_modules/playwright-core/types/**
node_modules/playwright-core/index.d.ts
node_modules/playwright-core/cli.js
node_modules/playwright-core/README.md

# Keep dist/, resources/, README.md, CHANGELOG.md, LICENSE,
# icon.png, package.json and all required runtime dependencies.

